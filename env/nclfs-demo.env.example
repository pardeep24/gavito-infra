# The NCLFS school app demo at nclfns.gavitotechnologies.com. Demo data only: this server is in
# India, and the real school's data belongs on its own server in Canada.
APP_ENV=staging
APP_BASE_DOMAIN=nclfns.gavitotechnologies.com
DNS_DRIVER=local
# Its own ports on 127.0.0.1, for health checks (the front proxy reaches it over Docker).
STAGING_PORT=8094
STATUS_PORT=8095
STATUS_PRODUCT=NCLFS School App (demo)
FRONT_PROXY_CONTAINER=gavito-edge
BACKUP_TZ=America/Winnipeg
# The database passwords, REDIS_PASSWORD and AUTH_SECRET are added on the first deploy.
