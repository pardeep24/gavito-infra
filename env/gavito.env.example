# Server-wide settings for ./gavito. Copy to env/gavito.env on the server; never commit it.

# Email Let's Encrypt writes to about certificates.
ACME_EMAIL=

# A fine-grained GitHub token with read-only "Contents" access to the five app repositories,
# used to fetch their code.
GITHUB_TOKEN=

# Encrypts ./gavito snapshot archives. Keep a copy OFF this server (a password manager): a snapshot
# can't be restored without it.
SNAPSHOT_PASSPHRASE=

# Retail's addresses, comma-separated. Add the old address only if env/retail.env has APP_OLD_DOMAIN.
RETAIL_HOSTS=retail.gavitotechnologies.com
